# Google Gemini - telemetry extraction and repository reasoning
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face - code/test generation
HF_TOKEN=
HF_CODE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_ANALYSIS_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
DATABASE_URL=sqlite+aiosqlite:///./rca_agent.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional shared secret for POST /api/webhooks/sentry (send as X-Sentry-Hook-Signature)
SENTRY_WEBHOOK_SECRET=

# Isolated verification (build backend/services/sandbox.Dockerfile first)
RCA_SANDBOX_IMAGE=agentic-rca-sandbox:py311

# Optional GitHub PR publishing; only runs after sandbox verification and user approval
GITHUB_TOKEN=
GITHUB_REPO=owner/repository
GITHUB_BASE_BRANCH=main
GITHUB_HTTP_TIMEOUT=15
